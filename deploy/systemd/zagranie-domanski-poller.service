[Unit]
Description=ZagranieBot - Domański Tip Poller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=boob92
WorkingDirectory=/opt/zagraniebot
EnvironmentFile=/etc/zagraniebot/zagraniebot.env
ExecStart=/usr/bin/flock -n -E 75 /tmp/zagranie-domanski-poller.lock /usr/bin/java -jar /opt/zagraniebot/zagranie-typer-0.1.0-SNAPSHOT.jar sync-new-tips
SuccessExitStatus=75
TimeoutStartSec=4min
StandardOutput=journal
StandardError=journal
