# Database
DB_URL=jdbc:postgresql://127.0.0.1:5432/zagranie_typer
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Zagranie live polling
ZAGRANIE_ALLOWED_AUTHOR_IDS=8033
ZAGRANIE_POLL_BOOTSTRAP_LOOKBACK_HOURS=720
ZAGRANIE_POLL_RECENT_SCAN_HOURS=72
ZAGRANIE_POLL_OVERLAP_SECONDS=120

# Telegram
# Use exactly the same bot token and channel/chat ID as the existing ZT bot.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=REUSE_EXISTING_ZT_BOT_TOKEN
TELEGRAM_CHAT_ID=REUSE_EXISTING_ZT_CHAT_ID
TELEGRAM_TIPSTER_NAME=Mateusz Domański

# Keep false on a fresh DB so the initial historical bootstrap does not spam Telegram.
TELEGRAM_NOTIFY_BOOTSTRAP=false
